{
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "jsx": "react-jsx",
    "jsxImportSource": "@lumeland/ssx",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "_includes/**/*.ts",
    "_includes/**/*.tsx",
    "examples/_config.ts"
  ]
}
