{
  "name": "lume-theme-blog",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "mod.ts",
  "scripts": {
    "build": "lume build",
    "serve": "lume build -s",
    "check": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --check .",
    "fix": "oxlint . --fix && oxfmt .",
    "test": "node --import tsx --import temporal-polyfill/global --test \"**/*.test.ts\""
  },
  "dependencies": {
    "@lumeland/plugin-base-path": "1.0.0",
    "@lumeland/plugin-jsx": "1.0.0",
    "@lumeland/plugin-nav": "1.0.0",
    "@lumeland/plugin-pagefind": "1.0.0",
    "@lumeland/plugin-remark": "1.0.1",
    "@lumeland/plugin-resolve-urls": "1.0.0",
    "@lumeland/ssx": "0.1.16",
    "@shikijs/rehype": "4.1.0",
    "@shikijs/transformers": "4.1.0",
    "@types/mdast": "4.0.4",
    "github-slugger": "2.0.0",
    "lume-plugin-mermaid": "github:ansanloms/lume-plugin-mermaid#0.1.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-extended-table": "2.0.3",
