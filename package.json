    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@lumeland/lume": "4.0.2",
    "@types/node": "24.19.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.94.0",
    "temporal-polyfill": "1.0.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@lumeland/core": "^1.0.4"
  }
